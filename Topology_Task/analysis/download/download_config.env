# Edit this file, then run:
#   python Topology_Task/analysis/download/download_wandb_group.py

# W&B location
ENTITY=corentin-plumet-epfl
PROJECT=Grid2Op

# Main selector: exact W&B run group name.
# Example:
# GROUP_NAME=wcci_reduced_mlp
# Other recent groups: wcci_sparse16_2, wcci_hvg_2, wcci_baseline_2, wcci_aib_2
GROUP_NAME=gs

# Optional alternatives / refinements. Leave empty unless needed.
# RUN_NAME_REGEX=^wcci_reduced_mlp_baseline_72x576_s[0-2]$
# EXP_TAG_REGEX=^wcci_reduced_mlp_baseline_72x576_s[0-2]$
RUN_NAME_REGEX=
EXP_TAG_REGEX=

# Comma-separated W&B states, or "all".
RUN_STATES=all

# Optional limit for testing.
MAX_RUNS=

# Output location. Default: Topology_Task/outputs/run_data
OUTPUT_ROOT=
DOWNLOAD_NAME=

# Existing downloaded runs are reused unless FORCE=true.
FORCE=false

# Keep both history.parquet and history.csv.gz. If parquet support is missing,
# CSV is written anyway.
WRITE_CSV=true

# Download W&B run files under each run's files/ folder. This can be heavy.
# Scalar history, config, summary, and file manifests are always downloaded.
DOWNLOAD_FILES=false

# Keep raw W&B history artifact shards. Usually unnecessary because the script
# writes a consolidated history.parquet/history.csv.gz.
KEEP_ARTIFACT_RAW=false

# Prefer scan_history instead of the W&B history artifact. Slower, but useful if
# artifact download is broken.
PREFER_SCAN_HISTORY=false

SCAN_PAGE_SIZE=200000
