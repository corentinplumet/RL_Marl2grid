# Config for Topology_Task/teacher_student/job_reduce_action_space_jed.sh
#
# Launch from repository root:
#   sbatch Topology_Task/teacher_student/job_reduce_action_space_jed.sh \
#     Topology_Task/teacher_student/reduction_configs/bus36_reduction_template.env
#
# Paths are interpreted from Topology_Task after the job starts.

# Dataset produced by collect_bruteforce_action_outcomes.py.
DATASET_ROOT=outputs/teacher_student_datasets/bus36_context_rho090_a1_2048_15jobs

# Output file name suffix. The job writes:
#   ${DATASET_ROOT}/metadata/reduced_action_space_${ACTION_REDUCTION_NAME}.json
# If ACTION_REDUCTION_OUTPUT is set, it overrides ACTION_REDUCTION_NAME.
ACTION_REDUCTION_NAME=edit_me
# ACTION_REDUCTION_OUTPUT=outputs/teacher_student_datasets/bus36_context_rho090_a1_2048_15jobs/metadata/custom_name.json

# Number of original action ids kept per agent after reduction.
ACTION_REDUCTION_TOP_K=208

# Minimum support threshold.
# - best_per_state: minimum number of state wins.
# - all_improving: minimum number of improving occurrences.
# - improvement_rate: minimum number of times the action was sampled.
ACTION_REDUCTION_MIN_COUNT=20

# Metric choices:
#   delta_vs_do_nothing
#   delta_vs_now
#   rho_after_action
ACTION_REDUCTION_METRIC=delta_vs_do_nothing

# Method choices:
#   best_per_state
#   all_improving
#   improvement_rate
ACTION_REDUCTION_METHOD=improvement_rate

# If true, only actions that strictly improve the metric are eligible.
# For delta metrics, improvement means:
#   metric < -ACTION_REDUCTION_IMPROVEMENT_TOLERANCE
ACTION_REDUCTION_REQUIRE_IMPROVEMENT=true
ACTION_REDUCTION_IMPROVEMENT_TOLERANCE=1e-3

